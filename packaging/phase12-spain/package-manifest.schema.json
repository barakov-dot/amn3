{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amn2.spain-install-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "self_hash_policy",
    "target",
    "artifacts",
    "resource_plan_sha256",
    "fingerprint_array_sha256",
    "run009_evidence_sha256",
    "awg_image"
  ],
  "properties": {
    "schema": {"const": "amn2.spain-install-package.v1"},
    "self_hash_policy": {"const": "manifest-excluded"},
    "target": {
      "const": {"architecture": "x86_64", "python_major_minor": "3.12"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "resource_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint_array_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run009_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "awg_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "index_digest", "platform_digest", "config_digest"],
      "properties": {
        "reference": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "index_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "platform_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
