PYTHONPATH=/opt/amn2-spain/runtime/site-packages:/opt/amn2-spain/runtime/source
DATABASE_PATH=/var/lib/amn2-spain/amn2.sqlite3
SERVER_CONFIG_PATH=/etc/amn2-spain/servers.yml
TELEGRAM_BOT_TOKEN=__AMN2_GENERATED_TELEGRAM_BOT_TOKEN__
TELEGRAM_RUNTIME_LOCK_PATH=/run/amn2-spain-bot/polling.lock
APP_SECRET_KEY=__AMN2_GENERATED_APP_SECRET_KEY__
WEB_ADMIN_PASSWORD_HASH=__AMN2_GENERATED_WEB_ADMIN_PASSWORD_HASH__
WEB_ADMIN_SESSION_SECRET=__AMN2_GENERATED_WEB_ADMIN_SESSION_SECRET__
VPS_APPLY_ENABLED=false
WEB_ADMIN_ENABLED=true
WEB_ADMIN_HOST=127.0.0.1
WEB_ADMIN_PORT=3031
WEB_ADMIN_SESSION_COOKIE_SECURE=false
APP_LOG_LEVEL=INFO
APP_LOG_PATH=/var/lib/amn2-spain/logs/app.log
CLIENT_CONFIG_TEMPLATE_DIR=/var/lib/amn2-spain/config-templates
SERVER_NAME=spain
VPN_SERVER_RUNTIME=docker
DEFAULT_VPN_NETWORK_CIDR=10.212.12.0/24
VPN_PORT_MIN=30001
VPN_PORT_MAX=30001
CLIENT_ALLOWED_IPS=0.0.0.0/0
