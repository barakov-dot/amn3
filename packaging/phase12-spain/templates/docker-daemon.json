{
  "hosts": ["unix:///run/amn2-spain-docker/docker.sock"],
  "group": "root",
  "data-root": "/var/lib/amn2-spain-docker",
  "storage-driver": "vfs",
  "features": {
    "containerd-snapshotter": false
  },
  "exec-root": "/run/amn2-spain-docker/exec",
  "pidfile": "/run/amn2-spain-docker/docker.pid",
  "bridge": "none",
  "firewall-backend": "nftables",
  "iptables": false,
  "ip6tables": false,
  "ip-forward": false,
  "ip-forward-no-drop": true,
  "ip-masq": false,
  "userland-proxy": false
}
