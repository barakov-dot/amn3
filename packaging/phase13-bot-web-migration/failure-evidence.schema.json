{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amn2.phase13.bot-web-migration-failure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "outcome_id",
    "checked_at",
    "stage",
    "reason_code",
    "decision",
    "safety_receipt"
  ],
  "properties": {
    "schema": {"const": "amn2.phase13.bot-web-migration-failure.v1"},
    "outcome_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "checked_at": {"type": "string", "format": "date-time"},
    "stage": {
      "enum": ["audit", "backup", "merge_preview", "stage", "cutover", "rollback"]
    },
    "reason_code": {
      "enum": [
        "audit_incomplete",
        "checksum_mismatch",
        "schema_validation_failed",
        "conflict_detected",
        "rollback_required"
      ]
    },
    "decision": {"const": "stop"},
    "safety_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_attempted",
        "raw_output_persisted",
        "secret_bearing_data_persisted"
      ],
      "properties": {
        "mutation_attempted": {"type": "boolean"},
        "raw_output_persisted": {"const": false},
        "secret_bearing_data_persisted": {"const": false}
      }
    }
  }
}
