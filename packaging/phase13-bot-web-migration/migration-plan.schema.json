{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amn2.phase13.bot-web-migration-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "migration_id",
    "source_role",
    "target_role",
    "source_audit_sha256",
    "target_audit_sha256",
    "preserve_target_app_secrets",
    "api_tokens_reissue_required",
    "usable_secret_records_imported",
    "live_mutation_authorized"
  ],
  "properties": {
    "schema": {"const": "amn2.phase13.bot-web-migration-plan.v1"},
    "migration_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "source_role": {"const": "usa-source"},
    "target_role": {"const": "spain-target"},
    "source_audit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_audit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preserve_target_app_secrets": {"const": true},
    "api_tokens_reissue_required": {"type": "integer", "minimum": 0},
    "usable_secret_records_imported": {"const": 0},
    "live_mutation_authorized": {"const": false}
  }
}
